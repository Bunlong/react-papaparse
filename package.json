{
  "name": "react-papaparse",
  "version": "5.0.0",
  "description": "The fastest in-browser CSV and delimited text parser for React. It includes a rich set of tools and components, such as CSVReader, CSVDownloader, readString, jsonToCSV, readRemoteFile, and more.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "clean": "rm -rf dist",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bunlong/react-papaparse.git"
  },
  "bugs": {
    "url": "https://github.com/Bunlong/react-papaparse/issues"
  },
  "author": "Bunlong",
  "license": "MIT",
  "homepage": "https://react-papaparse.js.org",
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/papaparse": "^5.3.9",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
