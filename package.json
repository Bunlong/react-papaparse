{
  "name": "react-papaparse",
  "version": "5.0.0",
  "description": "The fastest in-browser CSV and delimited text parser for React. It includes a rich set of tools and components, such as CSVReader, CSVDownloader, readString, jsonToCSV, readRemoteFile, and more.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "rollup -c -w",
    "build": "rollup -c",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size:check": "npm run build && bundlesize"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bunlong/react-papaparse.git"
  },
  "bugs": {
    "url": "https://github.com/Bunlong/react-papaparse/issues"
  },
  "author": "Bunlong",
  "license": "MIT",
  "homepage": "https://react-papaparse.js.org",
  "peerDependencies": {
    "papaparse": "^5.4.1",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/papaparse": "^5.3.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "bundlesize": "^0.18.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.8.4",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "bundlesize": [
    {
      "path": "./dist/**/*.js",
      "maxSize": "1030 B"
    },
    {
      "path": "./dist/**/*.d.ts",
      "maxSize": "1030 B"
    }
  ]
}
