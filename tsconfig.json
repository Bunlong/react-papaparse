{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "jsx": "react-jsx",

    "rootDir": "src",
    "outDir": "dist",

    "declaration": true,
    "declarationDir": "dist/types",

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  }
}
